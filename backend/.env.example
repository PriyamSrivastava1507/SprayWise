DATABASE_URL=sqlite:///./data/spraywise.db
STORAGE_DIR=./data/media
EVALUATION_DIR=./data/evaluation

# fake | unavailable | hf
SEGMENTATION_BACKEND=fake
# Hub ID, or a local folder containing the model AND processor files
HF_MODEL_ID=YOUR_USERNAME/cropweed-segformer-b0
# Only needed if the model repo is private
HF_TOKEN=

# Several ML models at once (replaces SEGMENTATION_BACKEND and HF_MODEL_ID when set).
# One line of JSON. "backend" is hf (default), fake or unavailable.
#ML_MODELS=[{"key":"cwfid","label":"ML (CWFID)","path":"./models/segformer-cwfid"},{"key":"we3ds","label":"ML (WE3DS)","path":"./models/segformer-we3ds"}]
#DEFAULT_ML_MODEL=cwfid
# Try the UI with two demo models, without torch:
#ML_MODELS=[{"key":"cwfid","label":"ML (CWFID)","backend":"fake"},{"key":"we3ds","label":"ML (WE3DS)","backend":"fake"}]

MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
WORKING_WIDTH=1024
PRESSURE_LOW_MAX=5.0
PRESSURE_HIGH_MIN=15.0

# Must be JSON
ALLOWED_ORIGINS=["http://localhost:5173"]
