# ==========================================
# SPRAYWISE - ROOT GITIGNORE
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/

# Node.js / React / Vite
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Databases
*.db
*.sqlite
*.sqlite3

# Uploaded images and generated media
backend/data/media/*
backend/data/evaluation/*
!backend/data/media/.gitkeep
!backend/data/evaluation/.gitkeep

# ML model checkpoints and weights
*.pt
*.pth
*.onnx
*.safetensors
*.h5
*.keras
*.pkl
*.joblib

# ML generated artifacts
ml-training/artifacts/checkpoints/*
ml-training/artifacts/metrics/*
!ml-training/artifacts/checkpoints/.gitkeep
!ml-training/artifacts/metrics/.gitkeep

# Training outputs
runs/
wandb/
lightning_logs/
tensorboard/

# ML handoff generated files
ml-handoff/predictions/*
ml-handoff/failure_cases/*
!ml-handoff/predictions/.gitkeep
!ml-handoff/failure_cases/.gitkeep

# Local datasets (review before committing)
# Uncomment if your dataset should remain local:
# test-dataset/images/*
# test-dataset/masks/*

# IDE and editors
.vscode/
.idea/
*.suo
*.user
*.swp

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.log
*.bak
